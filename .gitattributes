# Нормализация переводов строк: в репозитории — LF
* text=auto eol=lf

*.c   text eol=lf
*.cc  text eol=lf
*.cpp text eol=lf
*.h   text eol=lf
*.hpp text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh  text eol=lf
*.spec text eol=lf
*.desktop text eol=lf
*.svg text eol=lf

# Бинарные файлы
*.png binary
*.jpg binary
*.ico binary
*.rpm binary
*.tar.gz binary
*.zip binary
*.bin binary