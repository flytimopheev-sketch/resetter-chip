root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{cpp,h,hpp}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.sh]
indent_size = 4

[Makefile]
indent_style = tab

[*.{png,jpg,ico,rpm}]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false